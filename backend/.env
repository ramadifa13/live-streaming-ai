PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
DATABASE_URL="file:./dev.db"
BACKEND_PUBLIC_URL=http://localhost:4000

# AI / GPU
GPU_IDLE_TIMEOUT_MINUTES=30
GPU_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock
# Avatar Video Generation Provider: mock | replicate | liveportrait
AVATAR_PROVIDER=liveportrait
REPLICATE_API_TOKEN=

# RunPod GPU Worker configuration for LivePortrait/MuseTalk
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_POD_ID=5bragi1408v032
# Biarkan kosong agar backend otomatis menyusun URL dari RUNPOD_POD_ID,
# atau isi dengan http://localhost:8000 jika worker jalan di komputer yang sama.
RUNPOD_WORKER_URL=
AVATAR_WORKER_URL=

# ─── OAuth 2.0 Credentials ────────────────────────────────────────────────────
# TikTok Shop Live (https://developers.tiktok.com/apps/)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Shopee Live (https://open.shopee.com/documents)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# YouTube Live / Google OAuth (https://console.cloud.google.com/apis/credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram Live (https://developers.facebook.com/apps/)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Facebook Live (https://developers.facebook.com/apps/)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
