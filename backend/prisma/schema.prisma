generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Avatar {
  id             String   @id @default(cuid())
  name           String
  type           String
  style          String?
  language       String?
  voice          String?
  sampleAudioUrl String?
  isActive       Boolean  @default(true)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  liveSessions LiveSession[]
}

model Order {
  id               String    @id @default(cuid())
  resumeCode       String    @unique
  xenditInvoiceId  String?   @unique
  xenditExternalId String    @unique
  planId           String
  durationHours    Int
  amount           Int
  currency         String    @default("IDR")
  status           String    @default("pending_payment")
  sessionId        String?
  expiresAt        DateTime?
  paidAt           DateTime?
  consumedAt       DateTime?
  consumedReason   String?
  prepareAttempts  Int       @default(0)
  lastPrepareAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  liveSessions LiveSession[]
}

model LiveSession {
  id              String   @id @default(cuid())
  productId       String
  avatarId        String
  voice           String?
  status          String   @default("draft")
  platform        String
  durationHours   Int
  autoReply       Boolean  @default(true)
  autoPin         Boolean  @default(true)
  autoPromotion   Boolean  @default(true)
  autoModeration  Boolean  @default(true)
  estimatedCost   Int?
  revenueEstimate Int?
  runpodPodId      String?  @unique
  podStatus        String   @default("none")
  podCreatedAt     DateTime?
  podTerminatedAt  DateTime?
  liveStartedAt    DateTime?
  deadlineAt       DateTime?
  endedReason      String?
  clientRequestId  String?  @unique
  runtimeConfig    String?
  orderId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  avatar Avatar @relation(fields: [avatarId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])
}

model CostBenchmark {
  id               String   @id @default(cuid())
  metricName       String
  value            Float
  unit             String
  provider         String?
  benchmarkAt      DateTime @default(now())
  notes            String?
}
