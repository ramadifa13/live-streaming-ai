generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?
  price          Int
  stock          Int
  sku            String   @unique
  category       String?
  image          String?
  link           String?
  benefits       String?
  usage          String?
  faq            String?
  targetAudience String?
  copywriting    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Avatar {
  id          String   @id @default(cuid())
  name        String
  type        String
  style       String?
  language    String?
  voice       String?
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  liveSessions LiveSession[]
}

model LiveSession {
  id              String   @id @default(cuid())
  productId       String
  avatarId        String
  voice           String?
  status          String   @default("draft")
  platform        String
  durationHours   Int
  autoReply       Boolean  @default(true)
  autoPin         Boolean  @default(true)
  autoPromotion   Boolean  @default(true)
  autoModeration  Boolean  @default(true)
  estimatedCost   Int?
  revenueEstimate Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  avatar  Avatar  @relation(fields: [avatarId], references: [id])
}

model CostBenchmark {
  id               String   @id @default(cuid())
  metricName       String
  value            Float
  unit             String
  provider         String?
  benchmarkAt      DateTime @default(now())
  notes            String?
}
