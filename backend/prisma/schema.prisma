generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Avatar {
  id             String   @id @default(cuid())
  name           String
  type           String
  style          String?
  language       String?
  /// Host id untuk Piper live TTS (contoh: namira) — bukan Edge Neural id.
  voice          String?
  /// Sample pra-live (FE play lokal). Jangan hit pod TTS untuk preview.
  sampleAudioUrl String?
  isActive       Boolean  @default(true)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  liveSessions LiveSession[]
}

model LiveSession {
  id              String   @id @default(cuid())
  productId       String
  avatarId        String
  voice           String?
  status          String   @default("draft")
  platform        String
  durationHours   Int
  autoReply       Boolean  @default(true)
  autoPin         Boolean  @default(true)
  autoPromotion   Boolean  @default(true)
  autoModeration  Boolean  @default(true)
  estimatedCost   Int?
  revenueEstimate Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  avatar  Avatar  @relation(fields: [avatarId], references: [id])
}

model CostBenchmark {
  id               String   @id @default(cuid())
  metricName       String
  value            Float
  unit             String
  provider         String?
  benchmarkAt      DateTime @default(now())
  notes            String?
}
