# ==============================================================================
# LIVESTREAMER-AI BACKEND ENVIRONMENT (.env.example)
# ==============================================================================

PORT=4000
HOST=0.0.0.0

DATABASE_URL="file:./dev.db"

BACKEND_PUBLIC_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# LIVE BRAIN / LLM
# Provider: auto | groq | gemini
# LIVE_BRAIN_DURING_LIVE=0 → live pakai script bank (tanpa LLM per clip)
# LIVE_BRAIN_REFILL_WHEN_LOW=1 → LLM refill bank saat hampir habis (throttled)
# ------------------------------------------------------------------------------
LIVE_BRAIN_PROVIDER="auto"
LIVE_BRAIN_DURING_LIVE=0
LIVE_BRAIN_REFILL_WHEN_LOW=1
LIVE_BRAIN_MAX_INFLIGHT=12
LIVE_BRAIN_MAX_TOKENS=320
LIVE_BRAIN_TEMPERATURE=0.85
LIVE_BRAIN_BANK_MAX_TOKENS=2400
LIVE_BRAIN_PREPARE_PRODUCT_LLM=1
LIVE_BRAIN_CIRCUIT_MS=45000
LIVE_SCRIPT_BANK_LOW=12
LIVE_SCRIPT_BANK_LLM_REFILL_COOLDOWN_MS=90000
LIVE_SCRIPT_BANK_LLM_REFILL_MAX=16
LIVE_PENDING_TIMEOUT_MS=1800000
LIVE_MIN_BUFFER_SECONDS=6
LIVE_WORKER_WARMUP=0
# LIVE_BRAIN_COMMENT_WHEN_NEEDED=1
# LIVE_BRAIN_REFILL_ON_EXHAUST=1

GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# ------------------------------------------------------------------------------
# AVATAR / GPU
# ------------------------------------------------------------------------------
AVATAR_PROVIDER="mock"
GPU_PROVIDER="mock"
ALLOW_MEDIA_FALLBACK="false"
GPU_IDLE_TIMEOUT_MINUTES=30

RUNPOD_API_KEY=""
RUNPOD_NETWORK_VOLUME_ID=""
RUNPOD_POD_ID=""
# Kosongkan di VPS production (pod dinamis pakai proxy RunPod otomatis).
# Jangan set ke localhost:8000 di server — broadcast akan gagal ECONNREFUSED.
# RUNPOD_WORKER_URL="https://YOUR_POD_ID-8000.proxy.runpod.net"
RUNPOD_GPU_TYPE="NVIDIA GeForce RTX 4090"
RUNPOD_DATACENTER_ID=""
RUNPOD_GPU_RETRY=3
RUNPOD_CLOUD_TYPE="ALL"
# RUNPOD_GPU_STRICT=1
# RUNPOD_KEEP_POD_WARM=false

# ------------------------------------------------------------------------------
# TTS — Piper (open-source ID) di pod, venv TERPISAH dari MuseTalk
# Backend → worker :8000/tts/synthesize → Piper localhost :8090
# ------------------------------------------------------------------------------
TTS_ENGINE=piper
PIPER_VOICE=id_ID-news_tts-medium
# Opsional override langsung (dev lokal):
# PIPER_TTS_URL=http://127.0.0.1:8090
# Production: biarkan kosong — pakai RUNPOD_WORKER_URL/tts/synthesize

# ------------------------------------------------------------------------------
# OAUTH
# ------------------------------------------------------------------------------
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
SHOPEE_APP_ID=""
SHOPEE_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
