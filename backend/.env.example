# ==============================================================================
# BACKEND (.env)
# ==============================================================================

# ---- Server ----
PORT=4000
HOST=0.0.0.0

# SQLite (dev). Production: ganti ke postgres://...
DATABASE_URL="file:./dev.db"

# URL publik backend ini (dipakai OAuth callback & internal link)
BACKEND_PUBLIC_URL="http://localhost:4000"
# Izinkan request dari frontend (pisah dengan koma jika lebih dari satu)
CORS_ORIGIN="http://localhost:3000"

# ---- Live Brain / LLM ----
# Provider: auto | groq | gemini
# auto → coba groq dulu, fallback ke gemini
LIVE_BRAIN_PROVIDER="auto"
LIVE_BRAIN_DURING_LIVE=0          # 0 = pakai script bank saat live (lebih hemat)
LIVE_BRAIN_REFILL_WHEN_LOW=1      # LLM refill bank saat hampir habis
LIVE_BRAIN_MAX_INFLIGHT=12
LIVE_BRAIN_MAX_TOKENS=320
LIVE_BRAIN_TEMPERATURE=0.85
LIVE_BRAIN_BANK_MAX_TOKENS=3200
LIVE_BRAIN_CIRCUIT_MS=45000

# Script Bank
LIVE_SCRIPT_BANK_LOW=12
LIVE_SCRIPT_BANK_LLM_REFILL_MAX=16
LIVE_SCRIPT_BANK_CAP=520
LIVE_SCRIPT_BANK_RECYCLE_BATCH=160
LIVE_SCRIPT_BANK_RECYCLE_ROUNDS=3
LIVE_SCRIPT_BANK_LOW_8H=24
LIVE_SCRIPT_BANK_LOW_24H=32
LIVE_SCRIPT_BANK_LLM_REFILL_MAX_8H=8
LIVE_SCRIPT_BANK_LLM_REFILL_MAX_24H=5
LIVE_SCRIPT_PREP_LINE_TARGET=28
LIVE_SCRIPT_BANK_FRESH_LOW=8
LIVE_SCRIPT_BANK_LLM_EXHAUST_BONUS=6
LIVE_SCRIPT_BANK_LLM_REFILL_COOLDOWN_MS=90000
LIVE_PENDING_TIMEOUT_MS=1800000

# Marathon Host Engine — memory + CTA cooldown
LIVE_RECENT_SPEECH_LIMIT=48
LIVE_SEMANTIC_MEMORY_LIMIT=64
LIVE_CTA_COOLDOWN_MS=45000
LIVE_BANNER_CTA_COOLDOWN_MS=90000
LIVE_PRICE_MENTION_COOLDOWN_MS=60000
LIVE_MAX_CYCLE_MINUTES=45
LIVE_SEMANTIC_DECAY_MS=1200000
LIVE_PARAPHRASE_VARIANT_RATE=0.18
LIVE_REPEAT_REJECT_SCORE=0.72

# Go Live: minimal N utterance siap sebelum izinkan mulai siaran
GO_LIVE_MIN_UTTERANCES=2

GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# ---- Avatar / GPU ----
AVATAR_PROVIDER="runpod"
GPU_PROVIDER="runpod"
ALLOW_MEDIA_FALLBACK=false
GPU_IDLE_TIMEOUT_MINUTES=30

# ---- RunPod ----
# RUNPOD_POD_ID kosong  → buat pod baru (on-demand) setiap sesi.
# RUNPOD_POD_ID terisi  → pakai pod itu langsung (health/resume), tidak find/create.
RUNPOD_API_KEY=""
RUNPOD_NETWORK_VOLUME_ID=""
RUNPOD_POD_ID=""
# Wajib diisi jika pakai pod statis (boleh dikosongkan jika ID-nya sudah cukup untuk proxy):
# RUNPOD_WORKER_URL="https://YOUR_POD_ID-8000.proxy.runpod.net"
RUNPOD_GPU_TYPE="NVIDIA GeForce RTX 4090"
RUNPOD_DATACENTER_ID=""
RUNPOD_GPU_RETRY=5
RUNPOD_CLOUD_TYPE="ALL"
RUNPOD_KEEP_POD_WARM=1

# ---- TTS (Piper CPU di-spawn backend, tanpa port) ----
TTS_ENGINE=piper
PIPER_VOICE=id_ID-news_tts-medium
PIPER_DEFAULT_HOST=namira

# ---- OAuth Platform ----
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
SHOPEE_APP_ID=""
SHOPEE_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
