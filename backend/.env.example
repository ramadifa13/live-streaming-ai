PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/livestreamerai
BACKEND_PUBLIC_URL=http://localhost:4000

# AI / GPU
GPU_IDLE_TIMEOUT_MINUTES=30
GPU_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock
# Avatar Video Generation Provider: mock | replicate | liveportrait
AVATAR_PROVIDER=mock
REPLICATE_API_TOKEN=

# RunPod GPU Worker configuration for LivePortrait/MuseTalk
RUNPOD_WORKER_URL=http://localhost:8000
AVATAR_WORKER_URL=


# ─── OAuth 2.0 Credentials ────────────────────────────────────────────────────
# TikTok Shop Live (https://developers.tiktok.com/apps/)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Shopee Live (https://open.shopee.com/documents)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# YouTube Live / Google OAuth (https://console.cloud.google.com/apis/credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram Live (https://developers.facebook.com/apps/)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Facebook Live (https://developers.facebook.com/apps/)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
