# ==============================================================================
# LIVESTREAMER-AI BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server Network Configuration
PORT=4000
HOST=0.0.0.0

# Database Configuration (Prisma SQLite by default, or PostgreSQL for Production)
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI CONFIGURATION (MANDATORY)
# Engine: @google/genai SDK | Model: gemini-3.6-flash
# Digunakan untuk: RAG Knowledge Base, Smooth Pivot Sales, Live Pitch Script, & 3D Gesture Reasoning
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# AVATAR & VIDEO GENERATION CONFIGURATION
# Options: "mock" (Local dev / no GPU needed), "liveportrait" (RunPod GPU Worker), "replicate"
# ------------------------------------------------------------------------------
AVATAR_PROVIDER="mock"
ALLOW_MEDIA_FALLBACK="true"

# ------------------------------------------------------------------------------
# RUNPOD GPU WORKER BRIDGE (For Realtime Live Streaming Lipsync on RTX 3090/4090)
# ------------------------------------------------------------------------------
RUNPOD_API_KEY="rpa_YourRunPodApiKeyHere"
RUNPOD_POD_ID="your-runpod-pod-id"
RUNPOD_WORKER_URL="http://localhost:8000"
RUNPOD_IDLE_TIMEOUT_MS=600000

# ------------------------------------------------------------------------------
# EDGE TTS & AUDIO CONFIGURATION
# ------------------------------------------------------------------------------
EDGE_TTS_VOICE="id-ID-GadisNeural"

# ------------------------------------------------------------------------------
# OPTIONAL: REPLICATE API (Only if AVATAR_PROVIDER=replicate)
# ------------------------------------------------------------------------------
REPLICATE_API_TOKEN=""

# ------------------------------------------------------------------------------
# OAUTH 2.0 CONFIGURATION (PLATFORM INTEGRATIONS)
# ------------------------------------------------------------------------------
# The public URL of this backend (used for OAuth callbacks). 
# Example: https://api.yourdomain.com
BACKEND_PUBLIC_URL="http://localhost:4000"

# TikTok OAuth
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""

# Shopee Open Platform
SHOPEE_APP_ID=""
SHOPEE_SECRET=""

# YouTube / Google Cloud Console
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Instagram Graph API
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# Facebook Live API
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
