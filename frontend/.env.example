# ==============================================================================
# FRONTEND (.env)
# ==============================================================================

# URL backend (diakses dari browser maupun server-side Next.js)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# URL aplikasi ini sendiri (dipakai OAuth redirect / link absolut)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL AI Worker (server-side only — untuk Next.js rewrite ke /live_videos)
AVATAR_WORKER_URL=http://localhost:8000
