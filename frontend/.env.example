# ==============================================================================
# FRONTEND (.env)
# ==============================================================================

# URL backend (diakses dari browser maupun server-side Next.js)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# URL aplikasi ini sendiri (dipakai OAuth redirect / link absolut)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL AI Worker RunPod (server-side only — Next.js rewrite /live_videos)
# Contoh: https://POD_ID-8000.proxy.runpod.net
AVATAR_WORKER_URL=https://YOUR_POD_ID-8000.proxy.runpod.net
