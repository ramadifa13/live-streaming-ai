# Frontend Environment Variables
# Copy this file to .env.local and fill in the actual values

# Backend API URL (for local development)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# AI Worker URL (for local development)
# The frontend connects with worker URLs natively to show realtime feedback where necessary
AVATAR_WORKER_URL=http://localhost:8000

# Base URL to map local images correctly
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# For RunPod production:
# NEXT_PUBLIC_BACKEND_URL=https://odmobbl78r5e79-4000.proxy.runpod.net
# AVATAR_WORKER_URL=https://odmobbl78r5e79-8000.proxy.runpod.net
