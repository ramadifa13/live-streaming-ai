# ==============================================================================
# FRONTEND (.env) / .env.local
# ==============================================================================

# URL backend (browser + server-side Next.js)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4000

# URL aplikasi ini (OAuth / link absolut)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# AI Worker URL (server-side Next rewrite /live_videos)
# Mode STATIS: samakan dengan RUNPOD_WORKER_URL di backend
#   AVATAR_WORKER_URL=https://POD_ID-8000.proxy.runpod.net
# Mode ON-DEMAND (production): biarkan placeholder / kosongkan — FE tidak perlu
#   hit worker untuk pre-live (preview suara = file lokal di /public/voices/)
AVATAR_WORKER_URL=https://YOUR_POD_ID-8000.proxy.runpod.net
