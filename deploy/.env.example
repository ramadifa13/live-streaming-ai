# ==============================================================================
# AI WORKER (.env)  — copy ke /workspace/ai_live_worker/.env di pod / network volume
# ==============================================================================

# ---- Server ----
PORT=8000

# ---- VoxCPM2 TTS (GPU, venv terpisah dari MuseTalk) ----
TTS_ENABLED=true
VOICE_ID=girl_cute_kids
TTS_LANGUAGE=id
VOXCPM2_MODEL_PATH=/workspace/models/voxcpm2
VOICE_ROOT=/workspace/voices
VOXCPM2_VENV=/workspace/voxcpm2_env
VOXCPM2_BIND_HOST=127.0.0.1
VOXCPM2_BIND_PORT=8091
VOXCPM2_CFG_VALUE=2.0
# 8 = lebih cepat untuk live (L40S); naikkan ke 10 jika butuh kualitas maksimum
VOXCPM2_INFERENCE_TIMESTEPS=8
# 1 = boleh voice-design jika reference.wav belum ada
VOXCPM2_ALLOW_VOICE_DESIGN=1
VOXCPM2_READY_TIMEOUT=600

# ---- MuseTalk ----
# L40S 48GB: 16 aman; RTX 4090 24GB: biasanya 8
MUSETALK_BATCH_SIZE=16
MUSETALK_USE_FLOAT16=1
MUSETALK_WARMUP_ON_START=0
MUSETALK_BBOX_SHIFT=0
MUSETALK_EXTRA_MARGIN=10
MUSETALK_UPPER_BOUNDARY=0.50
MUSETALK_SQUARE_PAD=1
MUSETALK_PARSING_MODE=jaw
MUSETALK_CHEEK_WIDTH=80
MUSETALK_MOUTH_STRENGTH=1.0
MUSETALK_TEMPORAL_SMOOTH=0
MUSETALK_MAX_DELTA=0
MUSETALK_FRAME_DELTA=0
MUSETALK_PREROLL_FRAMES=6
MUSETALK_MOUTH_WAIT_SEC=0
MUSETALK_PREROLL_TIMEOUT_SEC=1.5
MUSETALK_SYNC_SHIFT=0
MUSETALK_RAW_FEED=1
MUSETALK_SKIP_MP4=1

# ---- Broadcast / AI Worker ----
BROADCAST_MODE=ai_worker
IDLE_VIDEO="/workspace/ai_live_worker/assets/3d/namira_idle_1.mp4"
WORKER_REQUIRE_AUDIO=1

AI_WORKER_FPS=30
FRAME_FEED_WIDTH=720
FRAME_FEED_HEIGHT=1280

# idle_1 = true idle; talk pool tanpa idle_1 (bedakan rest vs talk)
AI_WORKER_TALK_CLIP=idle_2
AI_WORKER_TALK_CLIPS=idle_2,idle_3,idle_4
AI_WORKER_CRASH_CLIP=idle_1
AI_WORKER_EAGER_CLIPS=idle_1,idle_2,idle_3,idle_4
AI_WORKER_PRECACHE_CLIPS=idle_2,idle_3,idle_4
AI_WORKER_IDLE_VARIANTS=idle_1
AI_WORKER_IDLE_BREATH_CHANCE=0.18
# Rotasi talk lebih jarang = kurang kesan “ganti clip”
AI_WORKER_TALK_STREAK=8
# Grace singkat setelah audio habis sebelum utterance berikutnya (bukan full end_pose)
AI_WORKER_UTTERANCE_TAIL_FRAMES=3

AI_WORKER_AMBIENT_GESTURES=off
AI_WORKER_AMBIENT_MIN_SEC=4
AI_WORKER_AMBIENT_MAX_SEC=6

AI_WORKER_OVERLAP_FRAMES=8
AI_WORKER_MASK_FEATHER=3
AI_WORKER_CROSSFADE=10
AI_WORKER_RAW_QUEUE=24
AI_WORKER_RENDER_QUEUE=48
AI_WORKER_RAW_BLOCK_SEC=0.25
AI_WORKER_BROADCAST_MAX_LAG=8
AI_WORKER_IDLE_FALLBACK_AFTER=2
# Hold talk lebih lama = anti-idle antar ucapan (TTS+MuseTalk share GPU)
AI_WORKER_HOLD_TALK_SEC=20
AI_WORKER_BROADCAST_RENDER_WAIT_SEC=0.10
AI_WORKER_METRICS_LOG_SEC=30
AI_WORKER_METRICS_WINDOW=4096

# ---- RTMP — diisi runtime saat Go Live (dari backend) ----
RTMP_URL=""
STREAM_KEY=""
RTMP_FORCE_IPV4=1
RTMP_CONNECT_TIMEOUT_SEC=90
# libx264 only — jangan h264_nvenc (sering gagal di RunPod)
RTMP_VIDEO_CODEC=libx264
RTMP_X264_PRESET=veryfast
