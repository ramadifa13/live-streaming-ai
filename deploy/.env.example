# ==============================================================================
# LIVESTREAMER-AI RUNPOD AI WORKER ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Worker API Port (RunPod HTTP exposes port 8000 by default)
PORT=8000

# Chatterbox-TTS Indonesian Microservice
CHATTERBOX_SERVICE_URL="http://127.0.0.1:8090"
CHATTERBOX_PORT=8090
CHATTERBOX_DEVICE="cuda"

# Voice Cloning References Path
VOICE_REF_DIR="/workspace/ai_live_worker/assets/voice_refs"

# MuseTalk Inference Parameters
# RTX 4090 / 3090 / L4: batch 8-16, fp16 auto
# GPU Blackwell (PRO 4500/4000): butuh PyTorch CUDA 12.4+ — pakai RTX 4090 dulu
MUSETALK_BATCH_SIZE=8
MUSETALK_USE_FLOAT16=
MUSETALK_WARMUP_ON_START=0

# Audio Enforcement (1 = Worker requires pre-synthesized audio from Backend)
WORKER_REQUIRE_AUDIO=1

# RTMP Broadcast Configuration (Passed dynamically during live session start)
RTMP_URL=""
STREAM_KEY=""
IDLE_VIDEO="/workspace/ai_live_worker/assets/3d/namira_idle.mp4"

# Broadcaster smooth transitions (seconds)
BROADCAST_CROSSFADE_SECONDS=0.5
BROADCAST_FADE_SECONDS=0.4
BROADCAST_IDLE_CHUNK_SECONDS=1.5
BROADCAST_MAX_IDLE_SECONDS=6.0

# segment = FFmpeg per clip (default, stabil)
# frame_feed = satu encoder kontinu, idle interruptible per frame (lebih natural)
BROADCAST_MODE=frame_feed
FRAME_FEED_FPS=25
FRAME_FEED_WIDTH=720
FRAME_FEED_HEIGHT=1280
# Raw BGR+PCM handoff (otomatis ON saat frame_feed). Set 0 untuk paksa MP4.
MUSETALK_RAW_FEED=1
MUSETALK_SKIP_MP4=1
IDLE_HOLD_FRAMES=3
