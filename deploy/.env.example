# ==============================================================================
# AI Worker — multi-idle (idle_1 talk + idle_2/3 variasi)
# ==============================================================================

PORT=8000

CHATTERBOX_SERVICE_URL="http://127.0.0.1:8090"
CHATTERBOX_PORT=8090
CHATTERBOX_DEVICE="cuda"
VOICE_REF_DIR="/workspace/ai_live_worker/assets/voice_refs"

WORKER_REQUIRE_AUDIO=1

# --- MuseTalk (GPU lipsync) — precache HANYA idle_1 ---
MUSETALK_BATCH_SIZE=2
MUSETALK_USE_FLOAT16=
MUSETALK_WARMUP_ON_START=0
MUSETALK_BBOX_SHIFT=-5
MUSETALK_EXTRA_MARGIN=4
MUSETALK_UPPER_BOUNDARY=0.58
MUSETALK_SQUARE_PAD=1
MUSETALK_PARSING_MODE=jaw
MUSETALK_CHEEK_WIDTH=80
MUSETALK_MOUTH_STRENGTH=0.62
MUSETALK_TEMPORAL_SMOOTH=0.32
MUSETALK_MAX_DELTA=30
MUSETALK_PREROLL_FRAMES=6
MUSETALK_MOUTH_WAIT_SEC=0.02
MUSETALK_PREROLL_TIMEOUT_SEC=2.0
MUSETALK_SYNC_SHIFT=0

# --- Stream / canvas ---
BROADCAST_MODE=ai_worker
# idle_1 = pose menjelaskan (utama). Clip 24fps → samakan FPS worker.
IDLE_VIDEO="/workspace/ai_live_worker/assets/3d/namira_idle_1.mp4"
AI_WORKER_FPS=24
FRAME_FEED_WIDTH=720
FRAME_FEED_HEIGHT=1280

# Body bicara = idle_1. Variasi idle saat diam = idle_2, idle_3.
AI_WORKER_TALK_CLIP=idle_1
AI_WORKER_EAGER_CLIPS=idle_1,idle_2,idle_3,idle,point_up,point_down
AI_WORKER_PRECACHE_CLIPS=idle_1
AI_WORKER_IDLE_VARIANTS=idle_2,idle_3
AI_WORKER_AMBIENT_GESTURES=off
AI_WORKER_AMBIENT_MIN_SEC=12
AI_WORKER_AMBIENT_MAX_SEC=28

AI_WORKER_OVERLAP_FRAMES=10
AI_WORKER_MASK_FEATHER=15

AI_WORKER_RAW_QUEUE=24
AI_WORKER_RENDER_QUEUE=48
AI_WORKER_RAW_BLOCK_SEC=0.25
AI_WORKER_BROADCAST_MAX_LAG=8
AI_WORKER_IDLE_FALLBACK_AFTER=2
AI_WORKER_BROADCAST_RENDER_WAIT_SEC=0.10

AI_WORKER_METRICS_LOG_SEC=30
AI_WORKER_METRICS_WINDOW=4096

RTMP_URL=""
STREAM_KEY=""
RTMP_FORCE_IPV4=1
RTMP_CONNECT_TIMEOUT_SEC=90

# Meta: namira_idle_1/2/3_meta.json — base/end rest pose.
# Point CTA (point_up/down) ditunda sampai idle rest-pose lolos.
