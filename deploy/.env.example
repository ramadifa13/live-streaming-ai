# ==============================================================================
# AI WORKER (.env)  — copy ke /workspace/ai_live_worker/.env di pod
# ==============================================================================

# ---- Server ----
PORT=8000

# TTS tidak di worker — audio WAV dari backend.

# ---- MuseTalk ----
MUSETALK_BATCH_SIZE=8
MUSETALK_USE_FLOAT16=
MUSETALK_WARMUP_ON_START=0
MUSETALK_BBOX_SHIFT=0
MUSETALK_EXTRA_MARGIN=10
MUSETALK_UPPER_BOUNDARY=0.50
MUSETALK_SQUARE_PAD=1
MUSETALK_PARSING_MODE=jaw
MUSETALK_CHEEK_WIDTH=80
MUSETALK_MOUTH_STRENGTH=1.0
MUSETALK_TEMPORAL_SMOOTH=0
MUSETALK_MAX_DELTA=0
MUSETALK_FRAME_DELTA=0
MUSETALK_PREROLL_FRAMES=6
MUSETALK_MOUTH_WAIT_SEC=0
MUSETALK_PREROLL_TIMEOUT_SEC=2.0
MUSETALK_SYNC_SHIFT=0
MUSETALK_RAW_FEED=1
MUSETALK_SKIP_MP4=1

# ---- Broadcast / AI Worker ----
BROADCAST_MODE=ai_worker
IDLE_VIDEO="/workspace/ai_live_worker/assets/3d/namira_idle_1.mp4"
WORKER_REQUIRE_AUDIO=1

AI_WORKER_FPS=30
FRAME_FEED_WIDTH=720
FRAME_FEED_HEIGHT=1280

# Klip idle yang tersedia di /assets/3d/ (tanpa ekstensi .mp4)
# idle_1 = true idle saat diam; idle_1/2/3/4 = talk pool (max 2x beruntun)
AI_WORKER_TALK_CLIP=idle_2
AI_WORKER_TALK_CLIPS=idle_2,idle_3,idle_4,idle_1
AI_WORKER_CRASH_CLIP=idle_1
AI_WORKER_EAGER_CLIPS=idle_1,idle_2,idle_3,idle_4
AI_WORKER_PRECACHE_CLIPS=idle_2,idle_3,idle_4,idle_1
AI_WORKER_IDLE_VARIANTS=idle_1
AI_WORKER_IDLE_BREATH_CHANCE=0.18

AI_WORKER_AMBIENT_GESTURES=off
AI_WORKER_AMBIENT_MIN_SEC=4
AI_WORKER_AMBIENT_MAX_SEC=6

AI_WORKER_OVERLAP_FRAMES=12
AI_WORKER_MASK_FEATHER=3
AI_WORKER_CROSSFADE=6
AI_WORKER_RAW_QUEUE=24
AI_WORKER_RENDER_QUEUE=48
AI_WORKER_RAW_BLOCK_SEC=0.25
AI_WORKER_BROADCAST_MAX_LAG=8
AI_WORKER_IDLE_FALLBACK_AFTER=2
AI_WORKER_BROADCAST_RENDER_WAIT_SEC=0.10
AI_WORKER_METRICS_LOG_SEC=30
AI_WORKER_METRICS_WINDOW=4096

# ---- RTMP — isi saat Go Live ----
RTMP_URL=""
STREAM_KEY=""
RTMP_FORCE_IPV4=1
RTMP_CONNECT_TIMEOUT_SEC=90
# libx264 only — jangan h264_nvenc (sering gagal di RunPod)
RTMP_VIDEO_CODEC=libx264
RTMP_X264_PRESET=veryfast
