# ==============================================================================
# AI LIVE WORKER (.env)
# Konfigurasi ringkas & esensial. Nilai teknis internal menggunakan sensible defaults.
# ==============================================================================

# ---- Server ----
PORT=8000

# ---- Live Broadcast & Avatar ----
# Mode siaran selalu terkunci pada ai_worker (Continuous Frame Feed)
BROADCAST_MODE=ai_worker
AI_WORKER_FPS=30
FRAME_FEED_WIDTH=720
FRAME_FEED_HEIGHT=1280
IDLE_VIDEO="/workspace/ai_live_worker/assets/3d/namira_idle.mp4"
AI_WORKER_TALK_CLIPS="talk_1,talk_2,talk_3"

# ---- RTMP Target (Diisi saat Go Live dari Dashboard / Backend) ----
RTMP_URL=""
STREAM_KEY=""
# libx264 only — jangan h264_nvenc (sering gagal di RunPod)
RTMP_VIDEO_CODEC=libx264
RTMP_X264_PRESET=veryfast
