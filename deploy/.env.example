# ==============================================================================
# LIVESTREAMER-AI RUNPOD AI WORKER ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Worker API Port (RunPod HTTP exposes port 8000 by default)
PORT=8000

# Chatterbox-TTS Indonesian Microservice
CHATTERBOX_SERVICE_URL="http://127.0.0.1:8090"
CHATTERBOX_PORT=8090
CHATTERBOX_DEVICE="cuda"

# Voice Cloning References Path
VOICE_REF_DIR="/workspace/ai_live_worker/assets/voice_refs"

# MuseTalk Inference Parameters
# RTX 4090 / 3090 / L4: batch 8-16, fp16 auto
# GPU Blackwell (PRO 4500/4000): butuh PyTorch CUDA 12.4+ — pakai RTX 4090 dulu
MUSETALK_BATCH_SIZE=2
MUSETALK_USE_FLOAT16=
MUSETALK_WARMUP_ON_START=0

# Audio Enforcement (1 = Worker requires pre-synthesized audio from Backend)
WORKER_REQUIRE_AUDIO=1

# RTMP Broadcast Configuration (Passed dynamically during live session start)
RTMP_URL=""
STREAM_KEY=""
IDLE_VIDEO="/workspace/ai_live_worker/assets/3d/namira_idle.mp4"

# Broadcaster smooth transitions (legacy segment/frame_feed modes only)
BROADCAST_CROSSFADE_SECONDS=0.5
BROADCAST_FADE_SECONDS=0.4
BROADCAST_IDLE_CHUNK_SECONDS=1.5
BROADCAST_MAX_IDLE_SECONDS=6.0

# segment = FFmpeg per clip (legacy)
# frame_feed = satu encoder kontinu (legacy)
# ai_worker = pipeline visual real-time in-process (REKOMENDASI)
BROADCAST_MODE=ai_worker

# Samakan dengan aset video (720x1280 @ 25fps). Naikkan ke 30 setelah aset di-reencode.
AI_WORKER_FPS=25

# Decode ke RAM saat init. Gesture tambahan (wave,nod) untuk gerakan ambient natural.
AI_WORKER_EAGER_CLIPS=idle,talk_expressive,wave,nod

# MuseTalk latent precache: default talk_expressive saja (hindari OOM). all = semua clip.
AI_WORKER_PRECACHE_CLIPS=talk_expressive
AI_WORKER_CROSSFADE=4
AI_WORKER_MASK_FEATHER=9

# Queue pipeline — naikkan jika stream terlihat freeze saat RTMP connected
AI_WORKER_RAW_QUEUE=24
AI_WORKER_RENDER_QUEUE=48
AI_WORKER_RAW_BLOCK_SEC=0.25

# Visual playthrough — jangan potong clip sebelum end_pose
# Opsional per-clip: assets/3d/namira_idle_meta.json → {"base_pose_frame":0,"end_pose_frame":119}
AI_WORKER_OVERLAP_FRAMES=5
AI_WORKER_BBOX_SMOOTH=7

# Gerakan ambient saat idle (wave/nod acak). Matikan: AI_WORKER_AMBIENT_GESTURES=off
AI_WORKER_AMBIENT_GESTURES=wave,nod
AI_WORKER_AMBIENT_MIN_SEC=18
AI_WORKER_AMBIENT_MAX_SEC=42

# Fallback idle animator setelah N frame miss di broadcaster (cegah freeze RTMP)
AI_WORKER_IDLE_FALLBACK_AFTER=2

# Log metrics summary every N seconds (0 = disabled). Endpoint: GET /stream/worker-metrics
AI_WORKER_METRICS_LOG_SEC=30
AI_WORKER_METRICS_WINDOW=4096

FRAME_FEED_WIDTH=720
FRAME_FEED_HEIGHT=1280

# Legacy frame_feed only (diabaikan saat BROADCAST_MODE=ai_worker)
MUSETALK_RAW_FEED=1
MUSETALK_SKIP_MP4=1

# RTMP: paksa IPv4 di FFmpeg (1=on). Matikan jika pod hanya punya IPv6 DNS.
RTMP_FORCE_IPV4=1
# Tunggu handshake RTMP saat start-broadcast (detik). Klik Go Live IG dalam window ini.
RTMP_CONNECT_TIMEOUT_SEC=90
